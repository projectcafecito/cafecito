---
import '../styles/common.css';
import '../styles/content.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  keywords?: string;
  productCapabilities?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Project Cafecito builds practical AI tools for small business.',
  image = 'https://cafecito.tech/images/cafecito-banner.png',
  keywords,
  productCapabilities = [],
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteOrigin}/#organization`,
      name: 'Project Cafecito',
      description: 'Project Cafecito builds practical AI tools for small business.',
      url: siteOrigin,
      logo: `${siteOrigin}/images/cafecito.png`,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      name: 'Project Cafecito',
      url: siteOrigin,
      publisher: { '@id': `${siteOrigin}/#organization` },
      inLanguage: 'en-US',
    },
    ...pageSchemas,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-633BZ6PP7F" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-633BZ6PP7F');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {productCapabilities.map((capability) => <meta name="product:capability" content={capability} />)}
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="canonical" href={canonical} />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    <link rel="icon" href="/images/favicon.ico" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
