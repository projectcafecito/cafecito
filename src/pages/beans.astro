---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const features = [
  ['📡 Coverage', 'Beans searches a changing catalog of public-information sources/outlets. Coverage, availability, and update timing vary and do not imply source endorsement or unrestricted content rights.'],
  ['🧠 Semantic Search', 'Natural-language semantic search with an adjustable relevance threshold. Results can be incomplete or not relevant to every query; verify material information against canonical sources.'],
  ['🔍 Filtering', 'Filter by categories, named entities, geographic regions, content types, sources, and time ranges. Available fields vary by record.'],
  ['📈 Trend Context', 'Selected records may include available attention observations and related-coverage context. These observations do not establish accuracy, popularity, or completeness.'],
  ['🏷️ Automated Enrichment', 'Selected records may include automated entities, sentiment, topics, and regions. These classifications can be unavailable or incorrect and should be verified for consequential use.'],
  ['🔗 Related Coverage', 'Related articles may be linked across public-information sources/outlets when available. Relationships are context, not a guarantee of a complete narrative.'],
];
const beansSchema = {
  "@type": "SoftwareApplication",
  "@id": "https://cafecito.tech/beans/#software",
  name: "Beans",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description: "Live news and blogs platform with a browser-based News App, aggregation API, semantic search, structured filtering, JSON, and MCP support.",
  url: "https://cafecito.tech/beans/",
  sameAs: ["https://beans.cafecito.tech/"],
  provider: { "@id": "https://cafecito.tech/#organization" },
  featureList: features.map(([title]) => title),
};
---

<BaseLayout
  title="Beans News App, API & MCP | Project Cafecito"
  description="Beans is a live news and blogs platform with a News App, semantic search, rich filtering, clean JSON endpoints, and MCP support."
  image="https://cafecito.tech/images/beans-banner.png"
  keywords="Beans News App, Beans API, news API, blog API, vector search, MCP, Project Cafecito"
  jsonLd={beansSchema}
>
  <Nav />
  <header class="hero" id="what-is-beans">
    <div class="container">
      <section class="hero-frame hero-frame--beans">
        <article class="hero-copy">
          <p class="eyebrow">Project Cafecito / Beans</p>
          <h1>News &amp; Blogs API for AI Workflows</h1>
          <p>Beans is a public-information discovery and search API for developers, AI agents, research tools, and dashboards. Use semantic search, structured filters, and JSON or MCP responses to explore available source material. Coverage, update timing, and outputs vary by source and record.</p>
          <div class="hero-badges">
            <span class="shared-badge">MCP</span><span class="shared-badge">JSON</span><span class="shared-badge">Semantic Search</span><span class="shared-badge">Variable source coverage</span><span class="shared-badge shared-badge--ghost-mint">Live</span>
          </div>
        </article>
      </section>
    </div>
  </header>
  <main class="container">
    <section class="section" id="why-beans">
      <div class="section-title"><h2>Why Beans</h2><p>Use the API when your product needs current source material and controlled retrieval.</p></div>
      <div class="grid">{features.map(([title, text]) => <article class="card shared-panel"><h3>{title}</h3><p>{text}</p></article>)}</div>
    </section>
    <section class="section" id="get-beans">
      <div class="section-title"><h2>Get Started</h2><p>The supported Beans offering is live API and MCP access.</p></div>
      <div class="products products--no-media">
        <article class="product shared-panel shared-panel--interactive">
          <a class="product-link-overlay" href="https://developer.cafecito.tech/howtos/beans-howto" aria-label="Read the Beans API documentation"></a>
          <div><span class="tag shared-badge shared-badge--mint">Live</span><h3>🔌 API &amp; MCP</h3><p>Full endpoint reference, authentication, filtering, and examples for integrating Beans into an app, RAG pipeline, or agent. <a href="https://developer.cafecito.tech/howtos/beans-howto">Read the Beans API documentation</a>.</p></div>
        </article>
        <article class="product shared-panel shared-panel--interactive">
          <a class="product-link-overlay" href="https://beans.cafecito.tech/" aria-label="Open the Beans News App"></a>
          <div><span class="tag shared-badge shared-badge--mint">Live</span><h3>📰 News App</h3><p>The live Beans News App lets you search, filter, and explore news and blog trends in the browser. <a href="https://beans.cafecito.tech/">Open the Beans News App</a>.</p></div>
        </article>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
