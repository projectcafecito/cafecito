---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { inDevelopmentProducts, liveProducts } from '../data/products';

const productCapabilities = [
  ...liveProducts.flatMap((product) => product.capabilities.map((capability) => `${product.name}: ${capability}`)),
  ...inDevelopmentProducts.flatMap((product) => product.capabilities.map((capability) => `${product.name} (${product.statusLabel}): ${capability}`)),
];
---

<BaseLayout
  title="Project Cafecito | Tools for practical intelligence"
  description="Project Cafecito builds practical intelligence tools for public-information discovery, market research, and operational workflows."
  keywords="AI automation, news API, market intelligence, social media automation, medical billing automation, Project Cafecito"
  productCapabilities={productCapabilities}
>
  <Nav />
  <main>
    <header class="option-hero">
      <div class="container option-hero-content">
        <p class="eyebrow">Project Cafecito</p>
        <h1>Tools for practical intelligence.</h1>
        <p class="option-hero-question">What would you like to make easier?</p>
        <a class="btn btn-secondary" href="/products/">Browse all products</a>
      </div>
    </header>

    <section class="option-products" aria-labelledby="live-products-heading">
      <div class="container">
        <div class="option-section-heading">
          <h2 id="live-products-heading">Available now</h2>
        </div>
        <div class="option-product-grid">
          {liveProducts.map((product) => (
            <article class={`option-product-card option-product-card--${product.slug}`}>
              <img src={product.image} alt={`${product.name} product icon`} />
              <div class="option-product-card-content">
                <div class="option-product-card-meta">
                  <span class="shared-badge shared-badge--mint">{product.statusLabel}</span>
                  <span>{product.category}</span>
                </div>
                <h3>{product.name}</h3>
                {product.slug === 'beans' ? (
                  <p>Find relevant news and blog sources for your workflow.</p>
                ) : (
                  <p>Track market signals, events, and relationships in one place.</p>
                )}
                <a class="btn btn-primary" href={`/${product.slug}/`}>Explore {product.name}</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="option-roadmap" aria-labelledby="roadmap-heading">
      <div class="container">
        <div class="option-roadmap-heading">
          <div>
            <h2 id="roadmap-heading">Brewing next</h2>
          </div>
          <a href="/products/">See the lineup <span aria-hidden="true">→</span></a>
        </div>
        <div class="option-roadmap-items">
          {inDevelopmentProducts.map((product) => (
            <article class={`option-roadmap-item${product.slug === 'medicafe' ? ' option-roadmap-item--pilot' : ''}`}>
              <img src={product.image} alt="" />
              <div>
                <h3>{product.name}</h3>
                <p>{product.slug === 'medicafe' ? 'Clear, accountable medical billing operations.' : product.category}</p>
              </div>
              <div class="option-roadmap-item-actions">
                <span class={`shared-badge ${product.slug === 'medicafe' ? 'shared-badge--ghost-mint' : 'shared-badge--subtle'}`}>{product.statusLabel}</span>
                {product.slug === 'medicafe' && <a class="option-roadmap-item-action" href="/medicafe/">Explore MediCafe <span aria-hidden="true">→</span></a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .option-hero {
    min-height: 0;
    display: grid;
    align-items: end;
    padding: 1.75rem 0;
    background:
      linear-gradient(90deg, rgba(18, 11, 7, 0.96) 0%, rgba(18, 11, 7, 0.73) 53%, rgba(18, 11, 7, 0.35) 100%),
      url('/images/cafecito-banner.png') center / cover no-repeat;
    border-bottom: 1px solid rgba(234, 216, 191, 0.16);
  }

  .option-hero-content { max-width: 1120px; }
  .option-hero h1 { max-width: 18ch; margin: 0.5rem 0 0.65rem; font-size: clamp(2.4rem, 5vw, 4.2rem); }
  .option-hero-question { max-width: 43ch; margin: 0 0 1.5rem; color: rgba(245, 239, 229, 0.88); font-size: clamp(1.2rem, 2.4vw, 1.45rem); line-height: 1.5; }

  .option-products { padding: clamp(3.5rem, 8vw, 6.5rem) 0; }
  .option-section-heading { margin-bottom: 1.5rem; }
  .option-section-heading h2, .option-roadmap h2 { margin-top: 0.45rem; font-size: clamp(1.8rem, 4vw, 3.1rem); }
  .option-product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; }

  .option-product-card {
    min-height: 405px;
    position: relative;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border: 1px solid rgba(234, 216, 191, 0.23);
    border-radius: 24px;
    background: linear-gradient(145deg, rgba(72, 41, 22, 0.94), rgba(18, 11, 7, 0.98));
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.24);
  }

  .option-product-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(18, 11, 7, 0.96), rgba(18, 11, 7, 0.04) 72%); pointer-events: none; }
  .option-product-card--espresso { background: linear-gradient(145deg, rgba(18, 58, 56, 0.88), rgba(18, 11, 7, 0.98)); }
  .option-product-card > img { position: absolute; top: 1.5rem; right: 1.5rem; width: clamp(130px, 18vw, 210px); height: clamp(130px, 18vw, 210px); object-fit: cover; border: 1px solid rgba(245, 239, 229, 0.22); border-radius: 28px; transform: rotate(7deg); box-shadow: 0 18px 35px rgba(0, 0, 0, 0.3); }
  .option-product-card-content { position: relative; z-index: 1; width: 100%; padding: 1.6rem; }
  .option-product-card-meta { display: flex; align-items: center; gap: 0.55rem; color: rgba(245, 239, 229, 0.66); font-size: 0.82rem; }
  .option-product-card h3 { margin: 0.7rem 0 0.35rem; font-size: clamp(2rem, 4vw, 3.1rem); }
  .option-product-card p { max-width: 28ch; margin: 0; color: rgba(245, 239, 229, 0.88); font-size: 1rem; line-height: 1.5; }
  .option-product-card .btn { margin-top: 1.3rem; }

  .option-roadmap { padding: 2.5rem 0 4.5rem; }
  .option-roadmap-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .option-roadmap-heading > a { color: var(--latte); }
  .option-roadmap-items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
  .option-roadmap-item { display: grid; grid-template-columns: 54px minmax(0, 1fr) auto; align-items: center; gap: 0.8rem; padding: 0.8rem; border: 1px solid rgba(234, 216, 191, 0.17); border-radius: 16px; background: rgba(46, 22, 11, 0.36); }
  .option-roadmap-item--pilot { border-color: rgba(104, 218, 211, 0.42); background: linear-gradient(130deg, rgba(25, 63, 59, 0.42), rgba(46, 22, 11, 0.52)); }
  .option-roadmap-item-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 0.65rem; }
  .option-roadmap-item-action { display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem; min-height: 44px; padding: 0.6rem 0.85rem; border: 1px solid rgba(104, 218, 211, 0.55); border-radius: 10px; background: rgba(104, 218, 211, 0.12); color: #b7f5f1; font-size: 0.88rem; font-weight: 700; white-space: nowrap; }
  .option-roadmap-item-action:hover { background: rgba(104, 218, 211, 0.22); text-decoration: none; }
  .option-roadmap-item-action:focus-visible { outline: 2px solid var(--mint); outline-offset: 3px; }
  .option-roadmap-item img { width: 54px; height: 54px; border-radius: 12px; object-fit: cover; }
  .option-roadmap-item h3 { font-size: 1.1rem; }
  .option-roadmap-item p { margin: 0.25rem 0 0; color: rgba(245, 239, 229, 0.63); font-size: 0.85rem; }

  @media (max-width: 720px) {
    .option-hero { padding: 1.75rem 0; background-position: 63% center; }
    .option-product-grid, .option-roadmap-items { grid-template-columns: 1fr; }
    .option-product-card { min-height: 370px; }
  }

  @media (max-width: 460px) {
    .option-roadmap-heading { align-items: flex-start; flex-direction: column; }
    .option-roadmap-item { grid-template-columns: 46px 1fr; }
    .option-roadmap-item img { width: 46px; height: 46px; }
    .option-roadmap-item-actions { grid-column: 2; align-items: flex-start; }
  }
</style>
